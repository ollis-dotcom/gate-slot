# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is ignored by git.

# --- Supabase (required) ---
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key that bypasses RLS. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email via Resend (optional) ---
# Without a key the app works, but no emails are sent.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- App ---
# Public base URL, used in links inside emails
APP_URL=http://localhost:3000
# Warehouse time zone (default: Europe/Moscow)
APP_TIMEZONE=Europe/Berlin
# Random string; the daily keepalive cron must send it as a Bearer token
CRON_SECRET=
# Comma-separated emails that get access to the super-admin panel
SUPER_ADMIN_EMAILS=
